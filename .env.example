# ===== 出版 AI 系统环境配置 =====
# 复制本文件为 .env 并填写；.env 不提交、不截图、不打包
APP_ENV=demo
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=replace-with-random-string

# ===== 模型接入（验收必须真实调用）=====
# 模式：real = 真实模型；mock = 开发期模拟响应（页面/记录会标注）
LLM_MODE=real
LLM_BASE_URL=https://api.deepseek.com/v1
# 请填入你的 DeepSeek 模型标识（如 deepseek-chat；若你使用的 1017 版本有专门名称，请替换）
LLM_MODEL=deepseek-chat
# 请填入你的 API Key（以 sk- 开头）。此文件不要提交到 GitHub、不要发到聊天里
LLM_API_KEY=sk-PLEASE-REPLACE-WITH-YOUR-KEY

# ===== 限额（验收现场会展示；可在系统信息页查看）=====
LLM_TIMEOUT_S=30
TOOL_TIMEOUT_MS=3000
AI_RUN_TIMEOUT_S=120
MAX_TOOL_CALLS=10
MAX_LLM_ROUNDS=8
MAX_AI_RUNS=10
