  {
    "rule_code": "RULE-COST-015",
    "name": "成本测算公式口径",
    "business_type": "print_cost",
    "rule_type": "calc",
    "severity": "warning",
    "source": "出版印制业务规则（模拟数据，2026-11-01）",
    "content": {
      "type": "formula",
      "items": [
        {
          "name": "用纸量(令)",
          "formula": "ceil(qty × print_sheet ÷ 1000 × 1.05)"
        },
        {
          "name": "纸张费",
          "formula": "用纸量 × price_per_ream"
        },
        {
          "name": "印刷费",
          "formula": "qty ÷ 1000 × print_sheet × 千印张价 × 色数档"
        },
        {
          "name": "制版费",
          "formula": "色数档 × 80 元/色"
        },
        {
          "name": "装订费",
          "formula": "qty ÷ 1000 × price_per_1000"
        },
        {
          "name": "工艺费",
          "formula": "qty ÷ 1000 × price_per_1000（无工艺为 0）"
        }
      ],
      "message": "总成本 = 纸张费 + 印刷费 + 制版费 + 装订费 + 工艺费；单册成本 = 总成本 ÷ 印数"
    }
  },
